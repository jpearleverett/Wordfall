rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: owner can write, anyone authenticated can read (for leaderboards/friends)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Puzzle results subcollection (used by Cloud Functions for club goals)
      match /puzzleResults/{resultId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Push token subcollection
      match /pushToken/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // THE CLOUD SAVE. Rules v2 does NOT cascade a parent match to
      // subcollections, so without these two blocks every save silently
      // failed: PlayerContext writes users/{uid}/data/player and
      // EconomyContext writes users/{uid}/economy/current, both swallow the
      // permission error, and the player had NO cloud backup at all —
      // reinstalling or switching device lost level, stars, coins, gems,
      // entitlements, and the local purchase-dedup ledger.
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /economy/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Device push tokens (notifications.ts writes users/{uid}/tokens/push).
      match /tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Challenges are written TO a friend's subcollection by the sender,
      // so the writer is not the owner. Reads stay owner-only.
      match /challenges/{challengeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Server-owned (Admin SDK): purchase records and gift quota must never
      // be client-writable — they are the anti-double-grant ledgers.
      match /purchases/{purchaseId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /giftQuota/{quotaId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // Daily scores: owner can write own entry, anyone can read
    // Score bounds: 0..1_000_000 (sanity ceiling to prevent trivial leaderboard cheats)
    // The doc id MUST start with the caller's uid ("{uid}_{date}"). Without
    // that binding an attacker could pre-create dailyScores/{victimUid}_{today}
    // carrying their OWN userId field; the victim's later write then becomes
    // an update whose owner check can never pass, silently locking that player
    // off the leaderboard for the day. Squatting is cheap and targeted.
    match /dailyScores/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && docId.split('_')[0] == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
      allow update: if request.auth != null
        && docId.split('_')[0] == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
    }

    // Weekly scores: same pattern
    match /weeklyScores/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && docId.split('_')[0] == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
      allow update: if request.auth != null
        && docId.split('_')[0] == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
    }

    // MG2: per-event cumulative scores. Same shape/bounds as weeklyScores
    // but scoped under events/{eventId}/scores/{uid}. Each user owns
    // exactly one score doc per event; doc id == uid keeps that invariant.
    match /events/{eventId}/scores/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.userId == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000;
    }

    // Friendships: either participant can create a pending request, but
    // accepting (status: 'pending' → 'accepted') is restricted to the
    // non-requester so senders can't self-accept their own pending ask.
    // Deletes are allowed by either participant (decline / unfriend).
    match /friendships/{friendshipId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && resource.data.requestedBy != request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid in resource.data.users;
    }

    // Gifts: sender can create, recipient can read/update (claim)
    // The sendGift callable is the intended writer (it enforces a 5/day
    // quota and an idempotency key); this direct path is only the offline
    // fallback. It previously accepted ANY payload from the sender, so a
    // player could loop self-addressed gifts and mint unlimited lives/hints
    // (GiftInbox grants min(amount, 10) per doc). Constrained so the
    // fallback still works but carries no exploit: no self-gifting, bounded
    // amount, and it must arrive unclaimed.
    match /gifts/{giftId} {
      allow create: if request.auth != null
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount >= 1
        && request.resource.data.amount <= 5
        && request.resource.data.claimed == false;
      allow read: if request.auth != null &&
        (resource.data.toUserId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      // Recipient may only flip it to claimed — not rewrite the amount.
      allow update: if request.auth != null
        && resource.data.toUserId == request.auth.uid
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['claimed', 'claimedAt']);
    }

    // Clubs: members can read/write; create is tightly constrained so
    // attackers can't seed a fresh club with pre-inflated scores.
    //
    // Initial doc MUST satisfy:
    //   - name is a 1..64-char string
    //   - memberIds contains only the creator's UID
    //   - weeklyScore / totalScore initialize to zero (later incremented
    //     atomically via the clubGoalProgress Cloud Function)
    //   - createdAt is set to the request timestamp (server-time)
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 64
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.weeklyScore == 0
        && request.resource.data.totalScore == 0
        && request.resource.data.createdAt == request.time;
      // Members may only edit presentation fields. This was unrestricted,
      // which made the careful create-time guards above pointless: any
      // member could set weeklyScore to 999999999 (updateClubLeaderboard
      // ranks that field directly, awarding the diamond tier), rewrite
      // memberIds to expel everyone else, or make themselves ownerId.
      // Scores and membership are mutated by Admin-SDK functions only.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'description', 'lastActivityAt', 'recentEmojis', 'icon']);

      // Club messages
      // Must be a club member. Message size is capped server-side to prevent
      // oversize payloads. Delete is allowed by the author (for self-moderation)
      // or by the server (via Cloud Functions) for report-driven removal.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberIds
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 200;
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid;
      }

      // Club goals (managed by Cloud Functions)
      match /goals/{goalId} {
        allow read: if request.auth != null;
      }

      // Shared club goals — Clash-style collective-progress goals. Readable
      // by any club member; writes are Admin-SDK only (onPuzzleComplete +
      // rotateClubGoals manage all progress/completion state server-side).
      match /sharedGoals/{goalId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/clubs/$(clubId)).data.memberIds;
        allow write: if false;
      }
    }

    // Reports (user-generated reports of other users or messages)
    // Reporters can create; only server (admin) can read. Keeps reports private.
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetType in ['message', 'user']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500;
      // Admin-only read/write — reads return nothing to clients
      allow read, update, delete: if false;
    }

    // Block list: each user owns their own block entries
    match /users/{userId}/blockedUsers/{blockedUserId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ToS acceptance ledger: each user writes their own acceptance record
    match /users/{userId}/consent/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard snapshots (written by Cloud Functions, read by anyone)
    match /leaderboards/{leaderboardId} {
      allow read: if request.auth != null;
    }

    // Rate-limit counters (server-side only — clients must never read/write).
    // Cloud Functions bump these atomically under checkFirestoreRateLimit;
    // exposing them to clients would let attackers clear their own bucket.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // Referral code → uid index. Anyone authenticated can read (so the app
    // can preview a code before applying it), but only the owning user can
    // write their own entry so a malicious client can't hijack someone
    // else's code mapping.
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      // On UPDATE the check must read the EXISTING doc. Checking
      // request.resource (the attacker's own payload) was trivially
      // satisfiable, so anyone could repoint a public 6-char referral code
      // at their own uid and harvest every reward the real owner earned.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Referral dedup docs (server-only via Admin SDK). Written inside the
    // atomic onReferralSuccess txn to prevent double-grant; exposing them
    // to clients would let attackers clear dedup entries and replay grants.
    match /referrals/{dedupId} {
      allow read, write: if false;
    }

    // Reward inbox (server writes via Admin SDK; recipient can read + flip
    // claimed true). Grants are written by onReferralSuccess / gifts flow.
    // Clients can update but not create/delete — they can only acknowledge
    // rewards the server has already written.
    match /users/{userId}/rewards/{rewardId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Acknowledge-only. An unconstrained update let a client rewrite the
      // granted amounts (gems: 1000000) and flip `claimed` back to false to
      // re-claim indefinitely, since the client grants straight from these
      // fields. The only legal transition is unclaimed -> claimed, touching
      // nothing else.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['claimed', 'claimedAt']);
      allow create, delete: if false;
    }
  }
}
